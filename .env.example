# Copy this file to `.env` and adjust. `.env` is ignored by git; never commit real values.
# Every variable is validated at server startup by src/server/env.ts.

# development | test | production. Set automatically by `next dev`, `next build`/`next start`
# and Vitest; you normally do not set it yourself.
# NODE_ENV=development

# PostgreSQL connection string (postgres:// or postgresql://). Required.
# This default matches the local development database.
DATABASE_URL=postgres://opanel:opanel@localhost:5432/opanel

# Secret that signs and encrypts sessions. Required, at least 32 characters. Generate one with
# `openssl rand -base64 32`. Never commit a real value. This placeholder is for local use only.
BETTER_AUTH_SECRET=change-me-local-development-secret-0123456789

# The app's own origin (http:// or https://), with no path. Required.
APP_URL=http://localhost:3000
