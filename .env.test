# Loaded only by integration tests (NODE_ENV=test). Committed on purpose: it holds the
# local test database defaults from compose.yaml, not a secret.
# The test harness refuses any database whose name does not end in _test.
DATABASE_URL=postgres://opanel:opanel@localhost:5432/opanel_test

# Better Auth. Test-only placeholders, not secrets.
BETTER_AUTH_SECRET=test-secret-only-for-vitest-0123456789abcdef
APP_URL=http://localhost:3000
