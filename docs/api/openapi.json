          "code": {
            "type": "string",
            "enum": [
              "invalid_request",
              "unauthenticated",
              "forbidden",
              "not_found",
              "conflict",
              "last_admin",
              "unsupported_media_type",
              "rate_limited",
              "internal_error",
              "invalid_link"
            ],
            "description": "Stable, machine-readable error code. This is what clients branch on."
          },
          "detail": {
            "type": "string",
            "description": "Explanation for people. Wording may change."
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "Same value as the `X-Request-Id` header."
          },
          "errors": {
            "description": "Present on validation failures: one entry per failing field.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "description": "Dotted path of the field, e.g. `evidence.http.status`. Empty for the root."
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "detail",
          "requestId"
        ],
        "additionalProperties": false,
        "description": "An error, as RFC 9457 problem details (`application/problem+json`)."
