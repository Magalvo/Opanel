{
  "name": "opanel",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit && tsc -p mcp --noEmit",
    "check": "tsx scripts/check.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --cache --cache-strategy content",
    "format:check": "prettier --check . --cache --cache-strategy content",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project ui",
    "test:integration": "vitest run --project integration",
    "test:e2e": "node --run mcp:build && playwright test",
    "test:watch": "vitest",
    "test:db:drop": "tsx scripts/drop-test-databases.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin:recover": "tsx scripts/recover-admin.ts",
    "maintenance": "tsx scripts/maintenance.ts",
    "build:commands": "esbuild scripts/migrate.ts scripts/recover-admin.ts scripts/maintenance.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outdir=dist --out-extension:.js=.mjs",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "mcp:build": "esbuild mcp/src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --banner:js=\"#!/usr/bin/env node\" --outfile=mcp/dist/index.js"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@node-rs/argon2": "2.2.2",
    "better-auth": "1.7.22",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "next-themes": "0.4.6",
    "postgres": "4.1.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "jsdom": "31.0.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
