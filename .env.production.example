# Copy this file to `.env.production` for compose.production.yaml, and fill it in. Never
# commit the copy: `.env.production` is ignored by git. Every variable is described in
# .env.example; these are the ones a production install needs.

# The schema owner's password: the `db` service creates the owner with it, and `migrate`
# connects with it (MIGRATION_DATABASE_URL below). Generate one with `openssl rand -hex 32`.
POSTGRES_PASSWORD=change-me-owner

# The password of `opanel_app`, the role the app connects as, with only the rights it needs
# (WS-063). Created on a new database volume. Another `openssl rand -hex 32`.
OPANEL_APP_DB_PASSWORD=change-me-app

# The app's connection: the runtime role, with the password above.
DATABASE_URL=postgres://opanel_app:change-me-app@db:5432/opanel

# The migrations' connection: the schema owner, with POSTGRES_PASSWORD.
MIGRATION_DATABASE_URL=postgres://opanel:change-me-owner@db:5432/opanel

# Signs and encrypts sessions. At least 32 characters: `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# The public HTTPS address your reverse proxy serves, with no path.
APP_URL=https://opanel.example.com

# Required to create the first administrator on a production server: the setup page asks
# for it. `openssl rand -hex 32`. You may remove it once the first administrator exists.
SETUP_TOKEN=

# The example proxy (`--profile proxy`) takes your public name from OPANEL_SITE, set in the
# shell or in a `.env` file next to compose.production.yaml, not here: this file is the
# app's, and the proxy, which faces the internet, never sees its secrets (WS-067). With it,
# set APP_URL above to https://<that name> and CLIENT_IP_HEADER below.

# Optional: the header your reverse proxy puts the client's IP address in, for the sign-in
# limiter. Only if the proxy overwrites any value the client sends.
# CLIENT_IP_HEADER=x-forwarded-for
